{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "create-admin": "node scripts/createAdmin.js"
  },
  "nodemonConfig": {
    "watch": [
      "src/server.js",
      "src/controllers",
      "src/models",
      "src/routes",
      "src/services",
      "src/agents",
      "src/middleware",
      "src/config"
    ],
    "ext": "js",
    "ignore": [
      "src/tests/**",
      "src/uploads/**",
      "uploads/**",
      "*.log",
      "*.tmp",
      "*.json",
      "*.csv",
      "*.txt"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
